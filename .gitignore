# ===== DEPENDÊNCIAS =====
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== AMBIENTE =====
.env
.env.local
.env.production
.env.development

# ===== BANCO DE DADOS =====
*.db
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.sqlite

# ===== ARQUIVOS DE SISTEMA =====
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== ARQUIVOS DE EDITOR =====
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ===== ARQUIVOS DE BUILD =====
dist/
build/
*.tsbuildinfo

# ===== ARQUIVOS DO PRISMA =====
# NÃO ignore o schema.prisma, mas ignore o cliente gerado
# O cliente gerado NÃO deve ir pro git
src/database/generated/
!prisma/schema.prisma

# ===== ARQUIVOS DO FRONTEND =====

# Se você for usar PNGs, coloque-os no repositório
# !frontend/assets/images/*.png

# ===== ARQUIVOS DE TESTE =====
coverage/
.nyc_output/

# ===== ARQUIVOS TEMPORÁRIOS =====
tmp/
temp/
*.tmp